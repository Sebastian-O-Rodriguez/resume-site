---
import '../styles/global.css';
import Container from '../components/Container.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

export interface Props {
  title?: string;
}

const { title = 'Resume Site' } = Astro.props;
---

<!doctype html>
<html lang="en" class="">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Personal resume site" />
    <title>{title}</title>
    <!-- Inline script to set dark class before paint — prevents flash -->
    <script is:inline>
      (function() {
        var key = 'resume-site-theme';
        var saved = localStorage.getItem(key);
        if (saved === 'dark' || (saved === null && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground font-sans antialiased">
    <script>
      import '../lib/analytics';
    </script>
    <Container>
      <header class="flex items-center justify-between py-6">
        <span class="text-sm font-medium text-muted-foreground">Resume Site</span>
        <ThemeToggle />
      </header>
    </Container>
    <main>
      <slot />
    </main>
    <Container>
      <footer class="border-t border-border py-8 mt-24">
        <p class="text-center text-sm text-muted-foreground">
          &copy; {new Date().getFullYear()}
        </p>
      </footer>
    </Container>
  </body>
</html>