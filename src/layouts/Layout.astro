---
import '../styles/global.css';
import Container from '../components/Container.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Button from '../components/Button.astro';
import { site } from '../data/site';

export interface Props {
  title?: string;
}

const { title = 'Sebastian' } = Astro.props;
const { name, education, photoPath, links } = site;
---

<!doctype html>
<html lang="en" class="">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Personal resume site" />
    <title>{title}</title>
    <!-- Inline script to set dark class before paint — prevents flash -->
    <script is:inline>
      (function() {
        var key = 'resume-site-theme';
        var saved = localStorage.getItem(key);
        if (saved === 'dark' || (saved === null && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground font-sans antialiased">
    <script>
      import '../lib/analytics';
    </script>

    <!-- Header = identity zone: photo + name/education left, nav buttons right -->
    <header class="border-b border-border">
      <Container>
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 py-5">
          <div class="flex items-center gap-4 min-w-0">
            <img
              src={photoPath}
              alt="Profile photo of {name}"
              width="64"
              height="64"
              class="shrink-0 rounded-full object-cover border border-border"
            />
            <div class="min-w-0">
              <h1 class="text-lg md:text-xl font-serif font-semibold leading-tight truncate">{name}</h1>
              <p class="text-xs md:text-sm text-muted-foreground leading-snug line-clamp-2">{education}</p>
            </div>
          </div>

          <nav aria-label="Social links" class="flex flex-wrap items-center gap-2 sm:justify-end">
            {links.map((link) => (
              <Button
                href={link.href}
                variant="outline"
                size="sm"
                attributes={{ 'data-track-click': true, 'data-track-event': 'click', 'data-track-label': link.label }}
              >
                {link.label}
              </Button>
            ))}
            <ThemeToggle />
          </nav>
        </div>
      </Container>
    </header>

    <main>
      <slot />
    </main>

    <Container>
      <footer class="border-t border-border py-8 mt-24">
        <p class="text-center text-sm text-muted-foreground">
          &copy; {new Date().getFullYear()} {name}
        </p>
      </footer>
    </Container>
  </body>
</html>