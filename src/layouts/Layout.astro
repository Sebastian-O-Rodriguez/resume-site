C 119.38 19.73 136.83 14.68 159.20 11.61 C 170.94 10.00 206.29 10.02 222.70 11.66 C 247.78 14.15 281.14 20.04 308.70 26.83 C 326.54 31.23 324.77 29.34 325.56 44.91 C 325.93 52.25 326.66 65.45 327.19 74.25 C 330.70 132.54 330.81 128.70 325.53 128.73 C 323.73 128.75 322.99 127.59 321.16 122.00 C 319.95 118.29 316.79 110.83 314.14 105.44 C 293.32 63.02 256.86 34.12 212.32 24.70 C 198.21 21.72 178.41 21.10 164.20 23.18 C 127.42 28.58 100.43 47.16 86.25 76.82 C 79.45 91.04 77.83 98.76 77.76 117.25 C 77.69 135.22 78.81 141.07 84.65 153.44 C 97.87 181.43 120.91 199.29 179.70 227.08 C 214.65 243.60 240.64 256.90 255.03 265.63 C 269.24 274.25 288.55 288.31 294.02 294.02 L 297.33 297.48 L 286.47 308.37 C 274.42 320.44 263.38 335.89 257.05 349.50 C 254.94 354.04 253.09 357.75 252.94 357.75 C 252.78 357.75 251.54 356.66 250.18 355.34 Z" />
            </svg>
          </a>

          <nav aria-label="Social links" class="flex flex-wrap items-center gap-2 justify-end">
          {links.map((link) =>
            link.href === site.resume.download.href ? (
              <div class="relative" data-panel-root>
                <Button
                  variant="outline"
                  size="sm"
                  attributes={{ 'data-panel-open': true, 'aria-haspopup': 'dialog', 'data-track-click': true, 'data-track-event': 'click', 'data-track-label': link.label }}
                >
                  {link.label}
                </Button>
                <Panel title={site.resume.title} download={site.resume.download}>
                  <Fragment slot="doc"><ResumeDoc.Content /></Fragment>
                </Panel>
              </div>
            ) : (
              <Button
                href={link.href}
                variant="outline"
                size="sm"
                attributes={{ 'data-track-click': true, 'data-track-event': 'click', 'data-track-label': link.label }}
              >
                {link.label}
              </Button>
            )
          )}
            <ThemeToggle />
          </nav>
        </div>
      </Container>
    </header>

    <main>
      <slot />
    </main>

    <Container>
      <footer class="border-t border-border py-8 mt-24">
        <p class="text-center text-sm text-muted-foreground">
          &copy; {new Date().getFullYear()} {name}
        </p>
      </footer>
    </Container>
  </body>
</html>