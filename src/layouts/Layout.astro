---
import '../styles/global.css';
import Container from '../components/Container.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Button from '../components/Button.astro';
import Panel from '../components/Panel.astro';
import { site } from '../data/site';
import * as ResumeDoc from '../../content/resume/resume.md';
import Analytics from '@vercel/analytics/astro';

export interface Props {
  title?: string;
}

const { title = 'Sebastian Rodriguez' } = Astro.props;
const { name, links } = site;
---

<!doctype html>
<html lang="en" class="">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Personal resume site" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/sor-logo.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>
      (function() {
        var key = 'resume-site-theme';
        var saved = localStorage.getItem(key);
        if (saved === 'dark' || (saved === null && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground font-sans antialiased">
    <Analytics />
    <script>
      import '../lib/analytics';
    </script>

    <script>
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      gsap.registerPlugin(ScrollTrigger);

      // Scroll reveals — skip entirely under reduced motion so content stays visible naturally.
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        gsap.context(() => {
          gsap.utils.toArray('[data-reveal]').forEach((el) => {
            gsap.from(el, {
              y: 24,
              opacity: 0,
              duration: 0.7,
              ease: 'power2.out',
              scrollTrigger: { trigger: el, start: 'top 85%', once: true },
              onComplete: () => gsap.set(el, { clearProps: 'transform' }),
            });
          });
          gsap.from('.projects-grid > *', {
            y: 24,
            opacity: 0,
            duration: 0.6,
            ease: 'power2.out',
            stagger: 0.08,
            scrollTrigger: { trigger: '.projects-grid', start: 'top 80%', once: true },
            onComplete: () => gsap.set('.projects-grid > *', { clearProps: 'transform' }),
          });
        });
        window.addEventListener('load', () => ScrollTrigger.refresh());
      }
    </script>

    <!-- Header = wordmark left, nav buttons + theme toggle right -->
    <header class="border-b border-border">
      <Container>
        <div class="flex items-center justify-between gap-4 py-4">
          <a href="/" class="shrink-0 text-primary hover:opacity-80" aria-label="SOR — Sebastian O Rodriguez">
            <svg class="block h-7 w-auto" viewBox="0 0 854.66 707.75" fill="currentColor" aria-hidden="true" focusable="false">
