---
import '../styles/global.css';
import Container from '../components/Container.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Button from '../components/Button.astro';
import { site } from '../data/site';

export interface Props {
  title?: string;
}

const { title = 'Sebastian' } = Astro.props;
const { name, links } = site;
---

<!doctype html>
<html lang="en" class="">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Personal resume site" />
    <title>{title}</title>
    <!-- Inline script to set dark class before paint — prevents flash -->
    <script is:inline>
      (function() {
        var key = 'resume-site-theme';
        var saved = localStorage.getItem(key);
        if (saved === 'dark' || (saved === null && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground font-sans antialiased">
    <script>
      import '../lib/analytics';
    </script>

    <script>
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      gsap.registerPlugin(ScrollTrigger);

      // Scroll reveals — skip entirely under reduced motion so content stays visible naturally.
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        gsap.context(() => {
          gsap.utils.toArray('[data-reveal]').forEach((el) => {
            gsap.from(el, {
              y: 24,
              opacity: 0,
              duration: 0.7,
              ease: 'power2.out',
              scrollTrigger: { trigger: el, start: 'top 85%', once: true },
              onComplete: () => gsap.set(el, { clearProps: 'transform' }),
            });
          });
          gsap.from('.projects-grid > *', {
            y: 24,
            opacity: 0,
            duration: 0.6,
            ease: 'power2.out',
            stagger: 0.08,
            scrollTrigger: { trigger: '.projects-grid', start: 'top 80%', once: true },
            onComplete: () => gsap.set('.projects-grid > *', { clearProps: 'transform' }),
          });
        });
        window.addEventListener('load', () => ScrollTrigger.refresh());
      }
    </script>

    <!-- Header = wordmark left, nav buttons + theme toggle right -->
    <header class="border-b border-border">
      <Container>
        <div class="flex items-center justify-between gap-4 py-4">
          <a href="/" class="font-serif text-lg font-semibold shrink-0 hover:opacity-80">{name}</a>

          <nav aria-label="Social links" class="flex flex-wrap items-center gap-2 justify-end">
            {links.map((link) => (
              <Button
                href={link.href}
                variant="outline"
                size="sm"
                attributes={{ 'data-track-click': true, 'data-track-event': 'click', 'data-track-label': link.label }}
              >
                {link.label}
              </Button>
            ))}
            <ThemeToggle />
          </nav>
        </div>
      </Container>
    </header>

    <main>
      <slot />
    </main>

    <Container>
      <footer class="border-t border-border py-8 mt-24">
        <p class="text-center text-sm text-muted-foreground">
          &copy; {new Date().getFullYear()} {name}
        </p>
      </footer>
    </Container>
  </body>
</html>