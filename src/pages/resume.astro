---
import Layout from '../layouts/Layout.astro';
import Container from '../components/Container.astro';
import Button from '../components/Button.astro';
import { site } from '../data/site';

const { download } = site.resume;
---

<Layout title="Resume · Sebastian O Rodriguez">
  <Container>
    <section class="py-10 md:py-14">
      <div class="mx-auto max-w-4xl">
        <header class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="text-sm font-mono text-muted-foreground mb-1">Sebastian O Rodriguez</p>
            <h1 class="text-3xl md:text-4xl font-serif font-semibold leading-tight">Resume</h1>
          </div>
          <div class="flex gap-2">
            <Button
              href={download.href}
              variant="outline"
              size="sm"
              attributes={{
                'aria-label': 'Open Resume (PDF)',
                'data-track-click': true,
                'data-track-event': 'click',
                'data-track-label': 'Open Resume (PDF)',
              }}
            >
              Open PDF
            </Button>
            <Button
              href={download.href}
              variant="default"
              size="sm"
              attributes={{
                download: download.filename,
                'aria-label': download.label,
                target: '_self',
                'data-track-click': true,
                'data-track-event': 'click',
                'data-track-label': download.label,
              }}
            >
              Download PDF
            </Button>
            <Button
              href="/"
              variant="outline"
              size="sm"
              attributes={{ target: '_self', 'data-track-label': 'Back to Portfolio' }}
            >
              Back to Portfolio
            </Button>
          </div>
        </header>

        <div class="rounded-xl border border-border bg-card overflow-hidden shadow-inset">
          <iframe
            src="/resume.pdf#view=FitH"
            title="Sebastian O Rodriguez Resume (PDF)"
            class="block w-full h-[72vh] md:h-[80vh]"
          ></iframe>
        </div>
        <p class="mt-3 text-sm text-muted-foreground">
          PDF not loading in your browser?
          <a href={download.href} download={download.filename} class="text-primary underline underline-offset-4">Download it directly</a>.
        </p>
      </div>
    </section>
  </Container>
</Layout>
