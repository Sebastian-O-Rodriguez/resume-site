---
import Panel from './Panel.astro';

export interface Props {
  caseStudy?: {
    status: 'published' | 'placeholder';
    title?: string;
    subtitle?: string;
    body: string;
    image?: string;
    image2?: string;
  };
  /** Project title — panel headline falls back to it. */
  caseStudyTitle?: string;
  class?: string;
}

const { caseStudy, caseStudyTitle, class: className = '' } = Astro.props;
const panelTitle = caseStudy?.title ?? caseStudyTitle ?? 'Case study';
---

<article
  class:list={[
    'relative rounded-xl border border-border bg-card text-card-foreground shadow-inset transition-[transform,box-shadow] duration-200 hover:[transform:translateY(-2px)] hover:shadow-raised flex flex-col project-card',
    className,
  ]}
  data-panel-root
>
  {
    caseStudy && (
      <span
        class:list={['case-status-dot', caseStudy.status]}
        role="img"
        aria-label={caseStudy.status === 'published' ? 'Case study available' : 'Case study pending'}
      />
    )
  }
  <div class="flex flex-1 flex-col p-5">
    <slot />
  </div>
  {
    caseStudy && (
      <div class="mt-auto flex justify-end px-2.5 py-2">
        <button
          type="button"
          data-panel-open
          aria-haspopup="dialog"
          class="inline-flex h-11 items-center justify-center gap-2 rounded-md px-3 text-sm font-medium text-primary transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
        >
          <span>Read case study</span>
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-4 w-4"
          >
            <path d="M21 21v-4.8M21 16.2 15 10" />
            <path d="M21 7.8V3m0 0h-4.8M21 3l-6 6" />
            <path d="M3 16.2V21m0 0h4.8M3 21l6-6" />
            <path d="M3 7.8V3m0 0h4.8M3 3l6 6" />
          </svg>
        </button>
      </div>
    )
  }
  {
    caseStudy && (
      <Panel
        title={panelTitle}
        eyebrow="Case study"
        subtitle={caseStudy.subtitle}
        body={caseStudy.body}
        image={caseStudy.image}
        image2={caseStudy.image2}
        imagePlaceholder="Screenshot coming soon"
      />
    )
  }
</article>

<style>
  /* Square floor keeps cards from collapsing into squat wide rectangles as
   * column widths change; grid items grow beyond this if content is taller. */
  .project-card {
    aspect-ratio: 1 / 1;
  }

  .case-status-dot {
    position: absolute;
    top: 0.875rem;
    right: 0.875rem;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
  }
  .case-status-dot.published {
    background-color: #16a34a;
    box-shadow: 0 0 0 3px rgb(22 163 74 / 0.15), 0 0 10px rgb(22 163 74 / 0.55);
  }
  .case-status-dot.placeholder {
    background-color: #eab308;
    box-shadow: 0 0 0 3px rgb(234 179 8 / 0.15), 0 0 10px rgb(234 179 8 / 0.55);
  }
</style>
