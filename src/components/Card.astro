---
export interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<article
  class="rounded-xl border border-border bg-card text-card-foreground shadow-inset transition-[transform,box-shadow] duration-200 hover:[transform:translateY(-2px)] hover:shadow-raised {className}"
>
  <slot />
</article>