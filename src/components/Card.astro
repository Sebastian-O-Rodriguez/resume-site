---
import Panel from './Panel.astro';

export interface Props {
  caseStudy?: {
    status: 'published' | 'placeholder';
    title?: string;
    subtitle?: string;
    body: string;
    image?: string;
  };
  /** Project title — panel headline falls back to it. */
  caseStudyTitle?: string;
  class?: string;
}

const { caseStudy, caseStudyTitle, class: className = '' } = Astro.props;
const panelTitle = caseStudy?.title ?? caseStudyTitle ?? 'Case study';
---

<article
  class:list={[
    'relative rounded-xl border border-border bg-card text-card-foreground shadow-inset transition-[transform,box-shadow] duration-200 hover:[transform:translateY(-2px)] hover:shadow-raised flex flex-col h-full',
    className,
  ]}
  data-panel-root
>
  {
    caseStudy && (
      <span
        class:list={['case-status-dot', caseStudy.status]}
        title={caseStudy.status === 'published' ? 'Case study available' : 'Case study pending'}
      />
    )
  }
  <div class="flex flex-1 flex-col p-5">
    <slot />
  </div>
  {
    caseStudy && (
      <div class="mt-auto flex justify-end border-t border-border px-2.5 py-2">
        <button
          type="button"
          data-panel-open
          aria-haspopup="dialog"
          aria-label={`Read case study: ${panelTitle}`}
          title="Read case study"
          class="inline-flex h-10 w-10 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
        >
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-[18px] w-[18px]"
          >
            <polyline points="15 3 21 3 21 9" />
            <polyline points="9 21 3 21 3 15" />
            <line x1="21" x2="14" y1="3" y2="10" />
            <line x1="3" x2="10" y1="21" y2="14" />
          </svg>
        </button>
      </div>
    )
  }
  {
    caseStudy && (
      <Panel
        title={panelTitle}
        eyebrow="Case study"
        subtitle={caseStudy.subtitle}
        body={caseStudy.body}
        image={caseStudy.image}
        imagePlaceholder="Screenshot coming soon"
      />
    )
  }
</article>

<style>
  .case-status-dot {
    position: absolute;
    top: 0.875rem;
    right: 0.875rem;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
  }
  .case-status-dot.published {
    background-color: #16a34a;
    box-shadow: 0 0 0 3px rgb(22 163 74 / 0.15), 0 0 10px rgb(22 163 74 / 0.55);
  }
  .case-status-dot.placeholder {
    background-color: #eab308;
    box-shadow: 0 0 0 3px rgb(234 179 8 / 0.15), 0 0 10px rgb(234 179 8 / 0.55);
  }
</style>
