---
export interface Props {
  caseStudy?: {
    status: 'published' | 'placeholder';
    content: string;
  };
  class?: string;
}

const { caseStudy, class: className = '' } = Astro.props;
---

<article
  class:list={[
    'rounded-xl border border-border bg-card text-card-foreground shadow-inset transition-[transform,box-shadow] duration-200 hover:[transform:translateY(-2px)] hover:shadow-raised flex flex-col h-full',
    className,
  ]}
>
  <div class="flex flex-1 flex-col p-5">
    <slot />
  </div>
  {
    caseStudy && (
      <div class="mt-auto border-t border-border" data-case-study>
        <button
          type="button"
          data-case-study-toggle
          aria-expanded="false"
          class="flex w-full items-center justify-between gap-2 px-5 py-3 text-sm font-medium text-primary transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-inset"
        >
          <span>Read case study</span>
          <svg
            aria-hidden="true"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            class="case-study-chevron h-4 w-4 shrink-0"
          >
            <path d="M4 6l4 4 4-4" />
          </svg>
        </button>
        <div class="case-study-panel">
          <div class="case-study-inner">
            <div class="px-5 pb-5 text-sm leading-relaxed text-muted-foreground whitespace-pre-line">{caseStudy.content}</div>
          </div>
        </div>
      </div>
    )
  }
</article>

<style>
  .case-study-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 200ms ease-out;
  }
  .is-open .case-study-panel {
    grid-template-rows: 1fr;
  }
  .case-study-inner {
    min-height: 0;
    overflow: hidden;
  }
  .case-study-chevron {
    transition: transform 200ms ease-out;
  }
  .is-open .case-study-chevron {
    transform: rotate(180deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .case-study-panel,
    .case-study-chevron {
      transition: none;
    }
  }
</style>

<script>
  const toggles = document.querySelectorAll('[data-case-study-toggle]');
  toggles.forEach((btn) => {
    btn.addEventListener('click', () => {
      const root = btn.closest('[data-case-study]');
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      root?.classList.toggle('is-open', !expanded);
    });
  });
</script>
