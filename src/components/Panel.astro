---
/**
 * Shared project/resume overlay panel (native <dialog>, showModal).
 * Solid sticky toolbar (controls) + scrollable article body with equal gutters.
 * Desktop = bounded centered modal; mobile = full-screen view.
 * Image clicks open a shared lightbox with a project accent frame.
 */
import { site } from '../data/site';

export interface Props {
  title: string;
  eyebrow?: string;
  subtitle?: string;
  /** Body copy; blank line between paragraphs. */
  body?: string;
  /** Hero image served from /public. */
  image?: string;
  imageAlt?: string;
  /** Second image rendered below the hero. */
  image2?: string;
  image2Alt?: string;
  /** Renders a dashed figure placeholder when no image is set. */
  imagePlaceholder?: string;
  /** Renders a download icon button in the toolbar. */
  download?: { href: string; filename?: string; label: string };
  /** Force light theme regardless of site theme (resume panel only). */
  forceLight?: boolean;
  /** Suppress the panel title/blurb so the article body's own h1 leads. */
  hideTitle?: boolean;
  /** Subtle per-project accent for the lightbox frame. */
  accent?: string;
}

const { title, eyebrow, subtitle, body = '', image, imageAlt, image2, image2Alt, imagePlaceholder, download, forceLight, hideTitle, accent } = Astro.props;
/** Outbound link shown at the end of the panel — matched to the project by title. */
const project = site.projects.find((entry) => entry.title === title);
const href = project?.href;
const cta = project?.cta ?? 'View project';
const external = Boolean(href && /^https?:/.test(href));
---

<dialog
  class:list={['panel-dialog', forceLight && 'panel-dialog--light']}
  data-panel-dialog
  data-accent={accent}
  aria-label={title}
>
  <div class="panel-toolbar">
    <span class="panel-toolbar__title">{title}</span>
    <div class="panel-toolbar__actions">
      {
        download && (
          <a class="panel-icon-btn" href={download.href} download={download.filename} aria-label={download.label} data-tooltip={download.label}>
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-[18px] w-[18px]">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
              <polyline points="7 10 12 15 17 10" />
              <line x1="12" x2="12" y1="15" y2="3" />
            </svg>
          </a>
        )
      }
      {!forceLight && (
        <button type="button" data-panel-theme-toggle aria-label="Toggle dark mode" data-tooltip="Toggle dark mode" class="panel-icon-btn">
          <svg class="block dark:hidden" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
          </svg>
          <svg class="hidden dark:block" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </button>
      )}
      <button type="button" data-panel-close aria-label="Close panel" data-tooltip="Close" class="panel-icon-btn">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-[18px] w-[18px]">
          <path d="M18 6 6 18" />
          <path d="m6 6 12 12" />
        </svg>
      </button>
    </div>
  </div>

  <div class="panel-content">
    {
      eyebrow && <p class="panel-eyebrow">{eyebrow}</p>
    }
    {!hideTitle && <h2 class="panel-title">{title}</h2>}
    {
      subtitle && <p class="panel-subtitle">{subtitle}</p>
    }
    <figure class="panel-figure">
      {
        image ? (
          <img class="panel-image" src={image} alt={imageAlt ?? ''} loading="lazy" />
        ) : (
          imagePlaceholder && (
            <div class="panel-figure-placeholder">
              <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
                <rect width="18" height="18" x="3" y="3" rx="2" ry="2" />
                <circle cx="9" cy="9" r="2" />
                <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" />
              </svg>
              <span>{imagePlaceholder}</span>
            </div>
          )
        )
      }
    </figure>
    {
      image2 && (
        <figure class="panel-figure">
          <img class="panel-image" src={image2} alt={image2Alt ?? ''} loading="lazy" />
        </figure>
      )
    }
    {
      body && (
        <div class="panel-body" set:html={body} />
      )
    }
    <div class="panel-doc">
      <slot name="doc" />
    </div>
    {
      href && (
        <div class="panel-cta">
          <a class="panel-cta-link" href={href} {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
            {cta}
          </a>
        </div>
      )
    }
  </div>
</dialog>

<style>
  .panel-dialog {
    /* Elevated surface, distinct from card and page (P0-17). */
    background: var(--elevated);
    color: var(--foreground);
    position: fixed;
    inset: 0;
    margin: auto;
    padding: 0;
    border: 1px solid var(--border);
    /* Desktop = bounded centered modal with the page visible around it (P0-21/P0-22). */
    width: min(92vw, 72rem);
    height: min(88dvh, 56rem);
    max-width: none;
    max-height: none;
    overflow: hidden;
    border-radius: 0.75rem;
    box-shadow: 0 24px 64px rgb(0 0 0 / 0.35);
    display: flex;
    flex-direction: column;
  }

  /* Resume panel only — force the light token set regardless of site theme. */
  .panel-dialog--light {
    --background: #FFFFFF;
    --foreground: #322418;
    --card: #F5F0E7;
    --card-foreground: #322418;
    --primary: #322418;
    --primary-foreground: #FFFFFF;
    --secondary: #F2ECE2;
    --secondary-foreground: #322418;
    --muted: #F2ECE2;
    --muted-foreground: #6B5B48;
    --accent: #F2ECE2;
    --accent-foreground: #322418;
    --border: #D8CDBB;
    --ring: #5C482D;
    --elevated: #FFFFFF;
    --toolbar: #FBF7F0;
    color-scheme: light;
  }

  .panel-dialog[open] {
    animation: panel-in 200ms ease-out;
  }

  .panel-dialog::backdrop {
    background: rgb(0 0 0 / 0.45);
  }

  .panel-dialog[open]::backdrop {
    animation: panel-backdrop-in 200ms ease-out;
  }

  @keyframes panel-in {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes panel-backdrop-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* Solid sticky toolbar — content scrolls beneath it, never over it (P0-20). */
  .panel-toolbar {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.625rem 0.875rem 0.625rem 1.25rem;
    background: var(--toolbar);
    border-bottom: 1px solid var(--border);
  }

  .panel-toolbar__title {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--muted-foreground);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .panel-toolbar__actions {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    flex: none;
  }

  .panel-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 2.5rem;
    width: 2.5rem;
    border-radius: 0.375rem;
    color: var(--muted-foreground);
    transition: background-color 150ms ease-out, color 150ms ease-out;
  }

  .panel-icon-btn:hover {
    background: var(--accent);
    color: var(--accent-foreground);
  }

  .panel-icon-btn:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  .panel-content {
    flex: 1 1 auto;
    overflow-y: auto;
    /* One horizontal gutter on both sides — no asymmetric padding (P0-19). */
    padding: 2.25rem var(--panel-gutter, 2rem) 2.5rem;
  }

  /* Article rhythm, light CSS approach (P0-31/P0-32/P0-33): on desktop the
   * copy column sits left and the figures rail right (text-left | image-right);
   * mobile collapses to one readable column. Markdown body is untouched. */
  @media (min-width: 768px) {
    .panel-content {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 20rem;
      column-gap: 2.5rem;
      align-items: start;
    }
    .panel-title,
    .panel-subtitle {
      grid-column: 1 / -1;
    }
    .panel-figure {
      grid-column: 2;
    }
    .panel-body,
    .panel-doc {
      grid-column: 1;
    }
    .panel-cta {
      grid-column: 1 / -1;
    }
  }

  /* Never render a closed dialog — without this, scoped display:flex overrides
   * the UA closed-dialog rule and the element still lays out, inflating scrollWidth. */
  .panel-dialog:not([open]) {
    display: none;
  }

  /* One float: only the open dialog becomes a flex column. */
  .panel-dialog[open] {
    display: flex;
  }

  .panel-doc {
    margin-top: 1.25rem;
    max-width: 46rem;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--foreground);
  }
  .panel-doc :global(h1) {
    font-size: 1.375rem;
    margin: 0 0 0.25rem;
  }
  .panel-doc :global(h2) {
    font-size: 0.9375rem;
    margin: 1.25rem 0 0.375rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .panel-doc :global(h2:first-child) {
    margin-top: 0;
  }
  .panel-doc :global(p) {
    margin: 0 0 0.625rem;
  }
  .panel-doc :global(ul) {
    margin: 0 0 0.625rem;
    padding-left: 1.1rem;
    list-style: disc;
  }
  .panel-doc :global(li) {
    margin: 0.2rem 0;
  }
  .panel-doc :global(a) {
    color: var(--primary);
    text-decoration: underline;
  }
  .panel-doc :global(.dates) {
    float: right;
    color: var(--muted-foreground);
    font-size: 0.75rem;
  }

  .panel-eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted-foreground);
    margin-bottom: 0.375rem;
  }

  .panel-title {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--foreground);
    max-width: 42rem;
  }

  .panel-subtitle {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--muted-foreground);
    max-width: 42rem;
  }

  .panel-figure {
    margin: 1.5rem 0 0;
  }

  .panel-image {
    width: 100%;
    border-radius: 0.5rem;
    border: 1px solid var(--border);
    cursor: zoom-in;
  }

  .panel-figure-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    aspect-ratio: 16 / 9;
    border: 1px dashed var(--border);
    border-radius: 0.5rem;
    color: var(--muted-foreground);
    font-size: 0.8125rem;
  }

  .panel-body {
    margin-top: 1.5rem;
    max-width: 42rem;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--foreground);
  }
  /* Typography for the raw-HTML article bodies (set:html). */
  .panel-body :global(h2) {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    font-weight: 600;
    margin: 1.5rem 0 0.5rem;
  }
  .panel-body :global(h3) {
    font-size: 1rem;
    font-weight: 600;
    margin: 1.25rem 0 0.375rem;
  }
  .panel-body :global(p) {
    margin: 0 0 0.875rem;
  }
  .panel-body :global(a) {
    color: var(--primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .panel-body :global(a:hover) {
    opacity: 0.85;
  }
  .panel-body :global(strong) {
    font-weight: 600;
  }
  .panel-body :global(em) {
    font-style: italic;
  }
  .panel-body :global(code) {
    background: var(--muted);
    padding: 0.1rem 0.3rem;
    border-radius: 0.25rem;
    font-size: 0.875em;
  }
  .panel-body :global(img) {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    border-radius: 0.5rem;
    border: 1px solid var(--border);
    margin: 1rem 0;
  }
  .panel-body :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 1.5rem 0;
  }

  /* Architecture flow diagram (P0-31): copy + visual, single visual per story. */
  .panel-body :global(.arch-figure) {
    margin: 1.25rem 0;
  }
  .panel-body :global(.arch-flow) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .panel-body :global(.arch-step) {
    padding: 0.375rem 0.625rem;
    border: 1px solid var(--border);
    border-radius: 0.375rem;
    background: var(--muted);
    color: var(--foreground);
    font-size: 0.8125rem;
    font-weight: 500;
  }
  .panel-body :global(.arch-arrow) {
    color: var(--muted-foreground);
    font-size: 0.8125rem;
  }

  /* Article-end CTA (P1-13). */
  .panel-cta {
    margin-top: 1.5rem;
  }

  .panel-cta-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0 1.25rem;
    border-radius: 0.375rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--primary-foreground);
    background: var(--primary);
    transition: opacity 150ms ease-out;
  }

  .panel-cta-link:hover {
    opacity: 0.88;
  }

  .panel-cta-link:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  /* Image lightbox styles live in global.css — the dialog is created in JS,
   * so it carries no Astro scope attribute and scoped rules would not apply. */

  @media (max-width: 640px) {
    .panel-dialog {
      width: 100vw;
      height: 100dvh;
      max-width: none;
      max-height: none;
      border-radius: 0;
      border: none;
    }
    .panel-content {
      padding: 2rem 1.25rem 2.5rem;
    }
    .panel-title {
      font-size: 1.5rem;
    }
    .panel-figure-placeholder {
      aspect-ratio: 4 / 3;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .panel-dialog[open],
    .panel-dialog[open]::backdrop {
      animation: none;
    }
    .panel-icon-btn {
      transition: none;
    }
  }
</style>

<script>
  const dialogs = document.querySelectorAll<HTMLDialogElement>('[data-panel-dialog]');
  const themeKey = 'resume-site-theme';
  const html = document.documentElement;

  // Image lightbox — a topmost modal dialog; ESC closes only it, not the panel.
  const lightbox = document.createElement('dialog');
  lightbox.className = 'panel-lightbox';
  const lbImg = document.createElement('img');
  const lbClose = document.createElement('button');
  lbClose.type = 'button';
  lbClose.className = 'panel-lightbox-close';
  lbClose.setAttribute('aria-label', 'Close image');
  lbClose.setAttribute('data-tooltip', 'Close');
  lbClose.innerHTML =
    '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>';
  lightbox.append(lbImg, lbClose);
  document.body.append(lightbox);

  function openLightbox(src: string, accent?: string) {
    lbImg.src = src;
    lbImg.alt = '';
    if (accent) lightbox.style.setProperty('--accent-token', accent);
    lightbox.showModal();
  }
  function closeLightbox() {
    lightbox.close();
  }
  lightbox.addEventListener('click', (e) => {
    if (e.target === lightbox || (e.target as HTMLElement).closest('.panel-lightbox-close')) closeLightbox();
  });

  dialogs.forEach((dialog) => {
    const root = dialog.closest('[data-panel-root]');
    const openBtn = root?.querySelector('[data-panel-open]');
    const closeBtn = dialog.querySelector('[data-panel-close]');
    const accent = dialog.getAttribute('data-accent') || undefined;

    openBtn?.addEventListener('click', () => {
      dialog.showModal();
      document.body.classList.add('is-locked');
    });

    closeBtn?.addEventListener('click', () => {
      dialog.close();
      document.body.classList.remove('is-locked');
    });

    const themeToggle = dialog.querySelector('[data-panel-theme-toggle]');
    themeToggle?.addEventListener('click', () => {
      const dark = html.classList.toggle('dark');
      localStorage.setItem(themeKey, dark ? 'dark' : 'light');
    });

    // Expand article images in place instead of navigating.
    dialog.querySelectorAll<HTMLImageElement>('.panel-image, .panel-body img').forEach((img) => {
      img.addEventListener('click', (e) => {
        e.preventDefault();
        openLightbox(img.currentSrc || img.src, accent);
      });
    });
    dialog.querySelectorAll('.panel-body a[href]').forEach((a) => {
      const href = a.getAttribute('href') || '';
      if (/\.(png|jpe?g|gif|svg|webp)$/i.test(href)) {
        a.addEventListener('click', (e) => {
          e.preventDefault();
          openLightbox(href, accent);
        });
      }
    });

    // Backdrop click closes: native dialog routes backdrop clicks to the dialog element.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) {
        dialog.close();
        document.body.classList.remove('is-locked');
      }
    });

    // Restore scroll lock on every close path (X, backdrop, Escape, native close).
    const unlock = () => document.body.classList.remove('is-locked');
    dialog.addEventListener('close', unlock);
    dialog.addEventListener('cancel', unlock);
  });
</script>
