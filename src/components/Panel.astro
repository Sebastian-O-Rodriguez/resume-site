---
/**
 * Shared near-full-screen overlay panel (native <dialog>, showModal).
 * One template serves project case studies and the resume:
 * eyebrow → title → subtitle → figure (image or placeholder) → body → doc slot.
 * The opener lives outside this component inside the same [data-panel-root].
 */
export interface Props {
  title: string;
  eyebrow?: string;
  subtitle?: string;
  /** Body copy; blank line between paragraphs. */
  body?: string;
  /** Hero image served from /public. */
  image?: string;
  /** Renders a dashed figure placeholder (label) when no image is set. */
  imagePlaceholder?: string;
  /** Renders a download icon button in the panel actions row. */
  download?: { href: string; filename?: string; label: string };
}

const { title, eyebrow, subtitle, body = '', image, imagePlaceholder, download } = Astro.props;
const paragraphs = body.split(/\n{2,}/).filter(Boolean);
---

<dialog class="panel-dialog" data-panel-dialog aria-label={title}>
  <div class="panel-actions">
    {
      download && (
        <a class="panel-icon-btn" href={download.href} download={download.filename} aria-label={download.label} title={download.label}>
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-[18px] w-[18px]">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="7 10 12 15 17 10" />
            <line x1="12" x2="12" y1="15" y2="3" />
          </svg>
        </a>
      )
    }
    <button type="button" data-panel-close aria-label="Close panel" title="Close" class="panel-icon-btn">
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="h-[18px] w-[18px]">
        <path d="M18 6 6 18" />
        <path d="m6 6 12 12" />
      </svg>
    </button>
  </div>

  <div class="panel-content">
    {
      eyebrow && <p class="panel-eyebrow">{eyebrow}</p>
    }
    <h2 class="panel-title">{title}</h2>
    {
      subtitle && <p class="panel-subtitle">{subtitle}</p>
    }
    <figure class="panel-figure">
      {
        image ? (
          <img class="panel-image" src={image} alt={`${title} screenshot`} loading="lazy" />
        ) : (
          imagePlaceholder && (
            <div class="panel-figure-placeholder">
              <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
                <rect width="18" height="18" x="3" y="3" rx="2" ry="2" />
                <circle cx="9" cy="9" r="2" />
                <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" />
              </svg>
              <span>{imagePlaceholder}</span>
            </div>
          )
        )
      }
    </figure>
    {
      paragraphs.length > 0 && (
        <div class="panel-body">
          {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      )
    }
    <div class="panel-doc">
      <slot name="doc" />
    </div>
  </div>
</dialog>

<style>
  .panel-dialog {
    /* Center deterministically — preflight resets UA margin:auto to 0. */
    position: fixed;
    inset: 0;
    margin: auto;
    padding: 0;
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--card-foreground);
    width: 95vw;
    height: 95vh;
    max-width: none;
    max-height: none;
    overflow: hidden;
    border-radius: 0.75rem;
    box-shadow: 0 24px 64px rgb(92 72 45 / 0.35);
  }

  .panel-dialog[open] {
    animation: panel-in 200ms ease-out;
  }

  .panel-dialog::backdrop {
    background: rgb(0 0 0 / 0.45);
  }

  .panel-dialog[open]::backdrop {
    animation: panel-backdrop-in 200ms ease-out;
  }

  @keyframes panel-in {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes panel-backdrop-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .panel-actions {
    position: absolute;
    top: 0.875rem;
    right: 0.875rem;
    z-index: 10;
    display: flex;
    gap: 0.25rem;
  }

  .panel-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 2.5rem;
    width: 2.5rem;
    border-radius: 0.375rem;
    color: var(--muted-foreground);
    transition: background-color 150ms ease-out, color 150ms ease-out;
  }

  .panel-icon-btn:hover {
    background: var(--accent);
    color: var(--accent-foreground);
  }

  .panel-icon-btn:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  .panel-content {
    height: 100%;
    overflow-y: auto;
    padding: 3.5rem 2rem 2rem;
  }

  /* Rendered markdown documents (resume) projected into the doc slot. */
  .panel-doc {
    margin-top: 1.25rem;
    max-width: 46rem;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--foreground);
  }
  .panel-doc :global(h1) {
    font-size: 1.375rem;
    margin: 0 0 0.25rem;
  }
  .panel-doc :global(h2) {
    font-size: 0.9375rem;
    margin: 1.25rem 0 0.375rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .panel-doc :global(h2:first-child) {
    margin-top: 0;
  }
  .panel-doc :global(p) {
    margin: 0 0 0.625rem;
  }
  .panel-doc :global(ul) {
    margin: 0 0 0.625rem;
    padding-left: 1.1rem;
    list-style: disc;
  }
  .panel-doc :global(li) {
    margin: 0.2rem 0;
  }
  .panel-doc :global(a) {
    color: var(--primary);
    text-decoration: underline;
  }
  .panel-doc :global(.dates) {
    float: right;
    color: var(--muted-foreground);
    font-size: 0.75rem;
  }

  .panel-eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted-foreground);
    margin-bottom: 0.375rem;
  }

  .panel-title {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--foreground);
    padding-right: 5.5rem; /* keep clear of the actions row */
  }

  .panel-subtitle {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--muted-foreground);
  }

  .panel-figure {
    margin: 1.5rem 0 0;
  }

  .panel-image {
    width: 100%;
    border-radius: 0.5rem;
    border: 1px solid var(--border);
  }

  .panel-figure-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    aspect-ratio: 16 / 9;
    border: 1px dashed var(--border);
    border-radius: 0.5rem;
    color: var(--muted-foreground);
    font-size: 0.8125rem;
  }

  .panel-body {
    margin-top: 1.5rem;
    max-width: 42rem;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--foreground);
  }

  .panel-body > p + p {
    margin-top: 0.875rem;
  }

  @media (max-width: 640px) {
    .panel-dialog {
      width: 100vw;
      height: 100dvh;
      border-radius: 0;
      border: none;
    }
    .panel-content {
      padding: 3.5rem 1.25rem 1.5rem;
    }
    .panel-figure-placeholder {
      aspect-ratio: 4 / 3;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .panel-dialog[open],
    .panel-dialog[open]::backdrop {
      animation: none;
    }
    .panel-icon-btn {
      transition: none;
    }
  }
</style>

<script>
  const dialogs = document.querySelectorAll('[data-panel-dialog]');

  dialogs.forEach((dialog) => {
    const root = dialog.closest('[data-panel-root]');
    const openBtn = root?.querySelector('[data-panel-open]');
    const closeBtn = dialog.querySelector('[data-panel-close]');

    openBtn?.addEventListener('click', () => {
      dialog.showModal();
      document.body.style.overflow = 'hidden';
    });

    closeBtn?.addEventListener('click', () => {
      dialog.close();
    });

    // Backdrop click closes: a click landing outside the dialog's box hits the ::backdrop.
    dialog.addEventListener('click', (event) => {
      const rect = dialog.getBoundingClientRect();
      const inside =
        event.clientX >= rect.left &&
        event.clientX <= rect.right &&
        event.clientY >= rect.top &&
        event.clientY <= rect.bottom;
      if (!inside) {
        dialog.close();
      }
    });

    // Restore scroll lock on every close path (ESC, backdrop, X).
    dialog.addEventListener('close', () => {
      document.body.style.overflow = '';
    });
  });
</script>
