---
import { site } from '../data/site';

const { name, photoPath } = site;
---

<section class="pt-10 md:pt-14 pb-4" aria-label="Identity">
  <div class="flex flex-col items-center gap-5 text-center">
    <img
      src={photoPath}
      alt={`Profile photo of ${name}`}
      width="176"
      height="176"
      class="h-44 w-44 rounded-full object-cover border border-border shadow-sm"
    />
    <h1 class="text-4xl md:text-5xl font-serif font-semibold leading-tight">{name}</h1>
  </div>
</section>