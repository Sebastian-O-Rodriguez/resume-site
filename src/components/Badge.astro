---
export interface Props {
  variant?: 'default' | 'secondary';
  class?: string;
}
const { variant = 'default', class: className = '' } = Astro.props;
---

<span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium transition-colors focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 {variant === 'secondary' ? 'bg-secondary text-secondary-foreground' : 'bg-primary text-primary-foreground'} {className}">
  <slot />
</span>