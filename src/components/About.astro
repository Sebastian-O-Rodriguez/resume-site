---
import { site } from '../data/site';
import Container from './Container.astro';

const { blurb, workLately } = site;
---

<section class="py-12">
  <Container>
    <div class="prose prose-gray dark:prose-invert max-w-3xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-serif font-semibold mb-6">About</h2>
      <p class="text-base leading-relaxed text-foreground/90 mb-6">
        {blurb}
      </p>

      <h2 class="text-2xl md:text-3xl font-serif font-semibold mb-6">Work Lately</h2>
      <p class="text-base leading-relaxed text-foreground/90">
        {workLately}
      </p>
    </div>
  </Container>
</section>