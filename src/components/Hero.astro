---
import { site } from '../data/site';
import Container from './Container.astro';
import Button from './Button.astro';

const { name, education, photoPath, links } = site;
---

<section class="py-16 md:py-24">
  <Container>
    <div class="flex flex-col items-center md:flex-row md:items-start md:gap-12">
      <!-- Photo -->
      <div class="mb-6 md:mb-0 shrink-0">
        <img
          src={photoPath}
          alt="Profile photo"
          width="160"
          height="160"
          class="rounded-full object-cover border-2 border-border"
        />
      </div>

      <!-- Identity -->
      <div class="text-center md:text-left">
        <h1 class="text-4xl md:text-5xl font-serif font-semibold tracking-tight mb-2">
          {name}
        </h1>
        <p class="text-lg text-muted-foreground mb-6">{education}</p>

        <!-- Links row -->
        <nav aria-label="Social links" class="flex flex-wrap justify-center md:justify-start gap-3">
          {links.map((link) => (
            <Button href={link.href} variant="outline" size="sm" attributes={{ 'data-track-click': true, 'data-track-event': 'click', 'data-track-label': link.label }}>
              {link.label}
            </Button>
          ))}
        </nav>
      </div>
    </div>
  </Container>
</section>