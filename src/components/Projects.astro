---
import { site } from '../data/site';
import Container from './Container.astro';
import Card from './Card.astro';

const { projects } = site;
const active = projects.filter((p) => !p.draft);
const drafts = projects.filter((p) => p.draft);
---

<section class="py-12" data-reveal>
  <Container>
    <h2 class="text-2xl md:text-3xl font-serif font-semibold mb-8 text-center">Projects</h2>

    {active.length === 0 && drafts.length === 0 && (
      <p class="text-muted-foreground text-center">No projects listed yet.</p>
    )}

    <div class="grid gap-6 projects-grid">
      {active.map((project) => (
        <Card
          title={project.title}
          blurb={project.blurb}
          tags={project.tags}
          icon={project.icon}
          accent={project.accent}
          caseStudy={project.caseStudy}
        />
      ))}

      {drafts.map((project) => (
        <Card
          class="opacity-60"
          title={project.title}
          blurb={project.blurb}
          tags={project.tags}
          icon={project.icon}
          accent={project.accent}
        />
      ))}
    </div>
  </Container>
</section>
