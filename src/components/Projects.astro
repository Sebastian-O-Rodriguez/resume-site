---
import { site } from '../data/site';
import Container from './Container.astro';
import Card from './Card.astro';

import GuavaAiShort from './articles/guava-ai.astro';
import GuavaOsShort from './articles/guava-os.astro';
import GuavaBiShort from './articles/guava-bi.astro';
import PmladShort from './articles/pmlad.astro';
import RoutineMeShort from './articles/routine-me.astro';

/** Title → short-form panel article component. */
const PANEL_ARTICLES: Record<string, (props: Record<string, any>) => any> = {
  'Guava AI': GuavaAiShort,
  'Guava OS': GuavaOsShort,
  'Guava BI': GuavaBiShort,
  PMLaD: PmladShort,
  RoutineMe: RoutineMeShort,
};
const { projects } = site;
const active = projects.filter((p) => !p.draft);
const drafts = projects.filter((p) => p.draft);
---

<section class="py-12" data-reveal>
  <Container>
    <h2 class="text-2xl md:text-3xl font-serif font-semibold mb-2 text-center">Projects</h2>
    <p class="text-sm text-muted-foreground text-center mb-8">Explore my latest work</p>

    {active.length === 0 && drafts.length === 0 && (
      <p class="text-muted-foreground text-center">No projects listed yet.</p>
    )}

    <div class="grid gap-6 projects-grid">
      {active.map((project) => {
        const Short = PANEL_ARTICLES[project.title];
        return (
          <Card
            title={project.title}
            blurb={project.blurb}
            tags={project.tags}
            icon={project.icon}
            accent={project.accent}
            caseStudy={project.caseStudy}
          >
            {Short && <Short />}
          </Card>
        );
      })}

      {drafts.map((project) => (
        <Card
          class="opacity-60"
          title={project.title}
          blurb={project.blurb}
          tags={project.tags}
          icon={project.icon}
          accent={project.accent}
        />
      ))}
    </div>
  </Container>
</section>
