---
import { site } from '../data/site';
import Container from './Container.astro';
import Card from './Card.astro';
import Badge from './Badge.astro';

const { projects } = site;
const active = projects.filter((p) => !p.draft);
const drafts = projects.filter((p) => p.draft);
---

<section class="py-12" data-reveal>
  <Container>
    <h2 class="text-2xl md:text-3xl font-serif font-semibold mb-8 text-center md:text-left">Projects</h2>

    {active.length === 0 && drafts.length === 0 && (
      <p class="text-muted-foreground text-center">No projects listed yet.</p>
    )}

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 projects-grid">
      {active.map((project) => (
        <Card>
          <div class="p-5 flex flex-col h-full">
            <h3 class="text-lg font-semibold mb-2">{project.title}</h3>
            <p class="text-sm text-muted-foreground mb-4 flex-1">{project.description}</p>
            <div class="flex flex-wrap gap-2">
              {project.stack.map((tech) => (
                <Badge variant="secondary">{tech}</Badge>
              ))}
            </div>
          </div>
        </Card>
      ))}

      {drafts.map((project) => (
        <Card class="opacity-60">
          <div class="p-5 flex flex-col h-full">
            <h3 class="text-lg font-semibold mb-1">
              {project.title}
              <span class="ml-2 text-xs font-mono text-muted-foreground">DRAFT</span>
            </h3>
            <p class="text-sm text-muted-foreground mb-4 flex-1">{project.description}</p>
            <div class="flex flex-wrap gap-2">
              {project.stack.map((tech) => (
                <Badge variant="secondary">{tech}</Badge>
              ))}
            </div>
          </div>
        </Card>
      ))}
    </div>
  </Container>
</section>