# Environment Variables

# Supabase (analytics backend)
# Create a Supabase project at https://supabase.com, then copy these values:
PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
PUBLIC_SUPABASE_FUNCTIONS_URL=https://your-project-id.functions.supabase.co

# Vercel (set these in Vercel project settings → Environment Variables)
# PUBLIC_SUPABASE_URL  -> production + preview
# PUBLIC_SUPABASE_ANON_KEY -> production + preview